---
import Layout from '@layouts/Default.astro';
import { Pill } from '@eliancodes/brutal-ui';

const colors = ['bg-pink', 'bg-blue', 'bg-green', 'bg-yellow', 'bg-purple'];
const randomColor = colors[Math.floor(Math.random() * colors.length)];

---


<Layout
  title='Emotion Journal'
  pageTitle=' Emotion Journal'
  description='Write your thoughts and let us analyze them.'
>
  <main class={`${randomColor} p-6 min-h-screen flex flex-col items-center justify-center gap-8`}>
    <div class='text-5xl font-bold text-center'>
      Emotion Journal
    </div>

    <form id="journalForm" class="w-full max-w-lg bg-white p-6 border-4 border-black shadow-brutal">
      <label for="journalEntry" class="block text-lg font-bold mb-2">Write your journal entry:</label>
      <textarea
        id="journalEntry"
        name="journalEntry"
        class="w-full h-32 p-6 border-2 border-black resize-none focus:outline-none"
        placeholder="Type your thoughts here..."
        required
      ></textarea>
      <button type="button" id="analyzeButton" class="mt-4 w-full px-6 py-3 bg-black text-white border-4 border-black shadow-brutal hover:bg-gray-800 transition-colors font-bold text-lg">Analyze Emotions</button>
    </form>

    <div id="emotionResult" class="hidden mt-6 w-full max-w-lg bg-white p-6 border-4 border-black shadow-brutal">
      <h3 class="text-xl font-bold mb-4">Emotion Analysis</h3>
      <div id="emotionList" class="pl-6"></div>
    </div>
  </main>

  <script>
    const analyzeButton = document.getElementById('analyzeButton');
    const journalForm = document.getElementById('journalForm');
    const emotionResult = document.getElementById('emotionResult');
    const emotionList = document.getElementById('emotionList');

    analyzeButton.addEventListener('click', async () => {
      const journalEntry = document.getElementById('journalEntry').value;

      if (!journalEntry.trim()) {
        alert('Please enter your journal entry.');
        return;
      }

      try {
        // Show loading message
        analyzeButton.innerText = 'Analyzing...';
        analyzeButton.disabled = true;

        // Detect context from journal entry
        const { detectUserContext, saveUserContext } = await import('../../utils/contextDetector.js');
        const context = await detectUserContext(journalEntry);
        if (context && context.confidence === 'high') {
          saveUserContext(context);
          // Trigger update event
          window.dispatchEvent(new CustomEvent('contextUpdated'));
        }

        const { GoogleGenerativeAI } = await import("@google/generative-ai");
        const genAI = new GoogleGenerativeAI("AIzaSyB1YnVEN2iAEl4DprbHIq_DkRkoJSxPUns");
        const model = genAI.getGenerativeModel({ model: "gemini-2.5-flash" });
        const result = await model.generateContent(`Roleplay as an AI therapist assistant for an individual with ASD (autism). Analyze the content of this journal entry and provide a thoughtful, empathetic response. Write it as if an AI wrote it - be warm, understanding, and supportive. Use natural language with emojis. Write it as a cohesive paragraph, not bullet points. Do not mention that you are a therapist or AI. Here is the journal entry: ${journalEntry}`);

        // Clear previous emotions
        emotionList.innerHTML = '';

        // Get the full AI response
        const aiResponse = result.response.text();
        
        // Display the AI response with typing effect
        const responseDiv = document.createElement('div');
        responseDiv.className = 'ai-response text-lg leading-relaxed';
        emotionList.appendChild(responseDiv);
        
        // Type out the response character by character for AI-like effect
        let charIndex = 0;
        responseDiv.classList.add('typing'); // Add typing class for cursor
        const typingInterval = setInterval(() => {
          if (charIndex < aiResponse.length) {
            responseDiv.textContent = aiResponse.substring(0, charIndex + 1);
            charIndex++;
            // Scroll to bottom
            responseDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          } else {
            clearInterval(typingInterval);
            responseDiv.classList.remove('typing'); // Remove cursor when done
          }
        }, 20); // 20ms per character for natural typing speed

        emotionResult.classList.remove('hidden');
      } catch (error) {
        alert('Failed to analyze emotions.');
      } finally {
        analyzeButton.innerText = 'Analyze Emotions';
        analyzeButton.disabled = false;
      }
    });
  </script>
</Layout>

<style>
  .ai-response {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    color: #333;
    line-height: 1.8;
    white-space: pre-wrap;
    word-wrap: break-word;
  }
  
  .ai-response.typing::after {
    content: '▊';
    animation: blink 1s infinite;
    color: #666;
  }
  
  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
</style>
